{
  "name": "@ring-protocol/router-sdk",
  "description": "An sdk for routing swaps using Uniswap v2 and Uniswap v3.",
  "repository": "https://github.com/RingProtocol/sdks.git",
  "keywords": [
    "uniswap",
    "ethereum"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/tsup src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --external @ethersproject/abi,@ring-protocol/v2-sdk,@ring-protocol/sdk-core,@ring-protocol/uniswap-v2-sdk,@ring-protocol/v3-sdk,@ring-protocol/v4-sdk,@uniswap/swap-router-contracts,tiny-invariant,jsbi,@ethersproject/solidity",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --max-warnings 0",
    "release": "semantic-release",
    "start": "tsdx watch",
    "test": "tsdx test --runInBand --watch=false"
  },
  "dependencies": {
    "@ethersproject/abi": "^5.5.0",
    "@ethersproject/solidity": "5.8.0",
    "@ring-protocol/sdk-core": "workspace:*",
    "@ring-protocol/uniswap-v2-sdk": "workspace:*",
    "@ring-protocol/v2-sdk": "workspace:*",
    "@ring-protocol/v3-sdk": "workspace:*",
    "@ring-protocol/v4-sdk": "workspace:*",
    "@uniswap/swap-router-contracts": "^1.3.0",
    "jsbi": "3.2.5",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@types/jest": "^24.0.25",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "prettier": "^2.4.1",
    "tsdx": "^0.14.1"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      {
        "name": "main",
        "prerelease": false
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": "../../publishing/release-rules.cjs"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node ../../publishing/replace-workspace-deps.js"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/exec",
        {
          "successCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "failCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "execCwd": "../.."
        }
      ]
    ]
  },
  "version": "1.0.0",
  "module": "dist/index.mjs"
}
