{
  "name": "@ring-protocol/v3-sdk",
  "description": "⚒️ An SDK for building applications on top of Uniswap V3",
  "repository": "https://github.com/RingProtocol/sdks.git",
  "keywords": [
    "uniswap",
    "ethereum"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsup src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --external @ethersproject/abi,@ethersproject/solidity,@ring-protocol/sdk-core,@uniswap/swap-router-contracts,@uniswap/v3-periphery,@uniswap/v3-staker,tiny-invariant,tiny-warning,jsbi,@ethersproject/abstract-signer,@ethersproject/address,@ring-protocol/v2-sdk",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --max-warnings 0",
    "release": "semantic-release",
    "start": "tsdx watch",
    "test": "tsdx test --runInBand --watch=false"
  },
  "sideEffects": false,
  "dependencies": {
    "@ethersproject/abi": "^5.5.0",
    "@ethersproject/abstract-signer": "5.8.0",
    "@ethersproject/address": "5.8.0",
    "@ethersproject/solidity": "^5.0.9",
    "@ring-protocol/sdk-core": "workspace:*",
    "@ring-protocol/v2-sdk": "workspace:*",
    "@uniswap/swap-router-contracts": "^1.3.0",
    "@uniswap/v3-periphery": "^1.1.1",
    "@uniswap/v3-staker": "1.0.0",
    "jsbi": "3.2.5",
    "tiny-invariant": "^1.1.0",
    "tiny-warning": "^1.0.3"
  },
  "devDependencies": {
    "@types/jest": "^24.0.25",
    "@uniswap/v3-core": "1.0.0",
    "babel-jest": "25.5.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-functional": "^3.0.2",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-prettier": "^3.4.1",
    "jest": "25.5.0",
    "prettier": "^2.4.1",
    "tsdx": "^0.14.1",
    "typescript": "^4.3.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      {
        "name": "main",
        "prerelease": false
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": "../../publishing/release-rules.cjs"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node ../../publishing/replace-workspace-deps.js"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/exec",
        {
          "successCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "failCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "execCwd": "../.."
        }
      ]
    ]
  },
  "version": "1.0.0"
}
