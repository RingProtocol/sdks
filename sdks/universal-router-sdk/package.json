{
  "name": "@ring-protocol/universal-router-sdk",
  "description": "sdk for integrating with the Universal Router contracts",
  "repository": "https://github.com/RingProtocol/sdks.git",
  "keywords": [
    "uniswap",
    "ethereum"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsup src/index.ts --format cjs,esm --dts --sourcemap --clean --out-dir dist --external @openzeppelin/contracts,@ring-protocol/v2-sdk,@ring-protocol/permit2-sdk,@ring-protocol/router-sdk,@ring-protocol/sdk-core,@ring-protocol/uniswap-v2-sdk,@ring-protocol/v3-sdk,@ring-protocol/v4-sdk,@uniswap/universal-router,@uniswap/v2-core,@uniswap/v3-core,bignumber.js,ethers,tiny-invariant,@ethersproject/abi,jsbi",
    "docs": "typedoc",
    "forge:fix": "forge fmt",
    "lint": "yarn prettier",
    "lint:fix": "yarn prettier:fix && yarn forge:fix",
    "prettier": "prettier --check '**/*.ts' && prettier --check '**/*.json'",
    "prettier:fix": "prettier --write '**/*.ts' && prettier --write '**/*.json'",
    "release": "semantic-release",
    "test": "node --test ../../test/robinhood/network-only.test.cjs"
  },
  "dependencies": {
    "@ethersproject/abi": "5.8.0",
    "@openzeppelin/contracts": "4.7.0",
    "@ring-protocol/permit2-sdk": "0.1.4",
    "@ring-protocol/router-sdk": "workspace:*",
    "@ring-protocol/sdk-core": "workspace:*",
    "@ring-protocol/uniswap-v2-sdk": "workspace:*",
    "@ring-protocol/v2-sdk": "workspace:*",
    "@ring-protocol/v3-sdk": "workspace:*",
    "@ring-protocol/v4-sdk": "workspace:*",
    "@uniswap/universal-router": "2.0.0-beta.2",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v3-core": "1.0.0",
    "bignumber.js": "^9.0.2",
    "ethers": "^5.7.0",
    "jsbi": "3.2.5",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@types/chai": "^4.3.3",
    "@types/mocha": "^9.1.1",
    "@types/node": "^18.7.16",
    "@types/node-fetch": "^2.6.2",
    "chai": "^4.3.6",
    "dotenv": "^16.0.3",
    "eslint-plugin-prettier": "^3.4.1",
    "hardhat": "^2.25.0",
    "prettier": "^2.4.1",
    "ts-node": "^10.9.1",
    "tsdx": "^0.14.1",
    "tslib": "^2.3.0",
    "typedoc": "^0.21.2",
    "typescript": "^4.3.3"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      {
        "name": "main",
        "prerelease": false
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "angular",
          "releaseRules": "../../publishing/release-rules.cjs"
        }
      ],
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "node ../../publishing/replace-workspace-deps.js"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/exec",
        {
          "successCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "failCmd": "git restore ../../sdks/*/package.json ../../yarn.lock && [ -f ../../yarn.lock.bak ] && mv ../../yarn.lock.bak ../../yarn.lock || true; yarn",
          "execCwd": "../.."
        }
      ]
    ]
  },
  "sideEffects": false,
  "version": "1.0.0",
  "module": "dist/index.mjs"
}
